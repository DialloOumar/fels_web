# --- Flask ---
SECRET_KEY=change-me-to-a-long-random-string
FLASK_APP=app.py
FLASK_DEBUG=0

# --- Database ---
# Inside Docker the host is the compose service name, "db".
DB_PASSWORD=change-me
DATABASE_URL=postgresql+psycopg2://fels_user:change-me@db:5432/fels

# --- Public address (read by the Caddyfile) ---
# The domain whose A record points at this server, e.g. app.example.com.
# "localhost" for a local run.
APP_DOMAIN=localhost

# --- App settings ---
APP_DEFAULT_LANG=fr
# Secure session cookie: keep 1 behind Caddy (HTTPS). 0 only for plain-HTTP local runs.
SESSION_COOKIE_SECURE=1

# --- Super admin bootstrap ---
# Created automatically by `flask seed` on first run. Refuses to overwrite an
# existing super admin, so it is safe to leave these set on redeploys.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-on-first-deploy
ADMIN_EMAIL=
ADMIN_FULL_NAME=Administrateur

# --- Linode Object Storage (database backups) ---
S3_ENDPOINT_URL=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_PREFIX=
